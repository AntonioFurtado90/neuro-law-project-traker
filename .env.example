# Copy this file to .env for local development (docker-compose reads it).
# .env is gitignored; never commit real credentials.
# Same variable names are used in GitHub Actions (vars/secrets) to keep dev/prod parity.

# --- Database (Sprint 1+) ---
POSTGRES_USER=neurolaw
POSTGRES_PASSWORD=neurolaw
POSTGRES_DB=neurolaw
# Host-side port for local psql access; container-to-container traffic always uses 5432 internally.
POSTGRES_HOST_PORT=5433
# Used by the orchestrator only — scripts never talk to the database directly.
DATABASE_URL=postgres://neurolaw:neurolaw@db:5432/neurolaw?sslmode=disable

# --- Data sources (Sprint 2/3) ---
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
SENADO_API_BASE_URL=https://legis.senado.leg.br/dadosabertos
# Bill type filter for ingest-camara (e.g. PL, PEC, PLP). Single value for now.
CAMARA_BILL_TYPE=PL

# --- Run window (Sprint 2+) ---
RUN_WINDOW_START=
RUN_WINDOW_END=

# --- Relevance detection (Sprint 4) ---
KEYWORD_LIST_PATH=scripts/src/neurolaw/relevance/keyword_list.yaml

# --- Orchestrator ---
OUTPUT_DIR=./output
RUN_WORKDIR=./workdir
PY_STEP_TIMEOUT_SECONDS=120

# --- Shared ---
LOG_LEVEL=info
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=2
