{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuro-law-project-traker/contracts/ingestion_result.schema.json",
  "title": "IngestionResult",
  "description": "Envelope produced by an ingestion subcommand (e.g. ingest-camara, ingest-senado), consumed by the orchestrator.",
  "type": "object",
  "required": ["status", "items", "errors"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed"]
    },
    "items": {
      "type": "array",
      "items": { "$ref": "bill.schema.json" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
